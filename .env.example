# Local Postgres from `npx prisma dev --name baphub --detach`
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"

BETTER_AUTH_SECRET="generate-with: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth client (Web application). Authorized redirect URI:
#   http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Dev-only NetID sign-in so you can test several people without Google.
# Ignored when NODE_ENV=production.
ALLOW_DEV_LOGIN="true"

# NetIDs that are always committee chairs (comma-separated), so a fresh
# deployment has someone who can set things up. Add the rest in the app.
CHAIR_NETIDS="el4640"

# Committee Gmail account used to send confirmations and reminders.
# GMAIL_APP_PASSWORD is a Google "app password" (needs 2-Step Verification).
# Leave empty to only log emails (shown in the server console).
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
EMAIL_FROM_NAME="BAP Community Service"

# Shared secret for the daily reminder job (Vercel Cron sends it automatically).
CRON_SECRET="generate-with: openssl rand -hex 24"
